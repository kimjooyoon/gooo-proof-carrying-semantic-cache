contract "gooo-proof-carrying-semantic-cache/v1" {
  authority "metacode"
  precedence "REFUTED" "UNKNOWN" "CLOSED"
  unknown_fields "stage" "step" "reason" "unknown_class" "next_operation" "blocked_by"
  denominator "proof-carrying-semantic-cache-v1" count "7"
  normalization comments "ignored" whitespace "collapsed" string_literals "preserved"
  cache_key semantic_key "source-semantic-digest" dependency_binding "transitive-dependency-digest" origin_binding "immutable-origin-digest" toolchain_binding "go-toolchain-runner-digest" contract_binding "metacode-contract-digest"
  binding semantic_key stage "KEY" step "compare-semantic-cache-key" mismatch "REFUTED" unknown_class "SEMANTIC_KEY_UNAVAILABLE"
  binding dependency stage "BINDING" step "compare-transitive-dependency-binding" mismatch "REFUTED" unknown_class "DEPENDENCY_BINDING_UNAVAILABLE"
  binding origin stage "BINDING" step "compare-origin-binding" mismatch "REFUTED" unknown_class "ORIGIN_BINDING_UNAVAILABLE"
  binding toolchain stage "BINDING" step "compare-toolchain-runner-binding" mismatch "UNKNOWN" unknown_class "CROSS_TOOLCHAIN"
  binding contract stage "BINDING" step "compare-contract-binding" mismatch "REFUTED" unknown_class "CONTRACT_BINDING_UNAVAILABLE"
  obligation semantic_key stage "PROOF" step "verify-semantic-key" proof "SEMANTIC_KEY_MATCHED" missing "PROOF_RECEIPT_MISSING"
  obligation dependency_binding stage "PROOF" step "verify-dependency-binding" proof "DEPENDENCY_BINDING_MATCHED" missing "PROOF_RECEIPT_MISSING"
  obligation origin_binding stage "PROOF" step "verify-origin-binding" proof "ORIGIN_BINDING_MATCHED" missing "PROOF_RECEIPT_MISSING"
  obligation terminal_witness stage "PROOF" step "verify-terminal-witness" proof "TERMINAL_WITNESS_MATCHED" missing "PROOF_RECEIPT_MISSING"
  obligation artifact stage "PROOF" step "verify-generated-artifact" proof "ARTIFACT_DIGEST_MATCHED" missing "PROOF_RECEIPT_MISSING"
  witness terminal stage "WITNESS" step "compare-terminal-reason-effect" reason "terminal-reason" effect "terminal-effect" mismatch "REFUTED"
  reuse rule "proof-reuse" status "CLOSED" requires "all-bindings-proof-witness-oracle"
  fallback status "REFUTED" operation "independent-rebuild" unknown_class "KNOWN_CONTRADICTION"
  fallback status "UNKNOWN" operation "independent-rebuild" unknown_class "MISSING_EVIDENCE"
  replay rule "deterministic-replay" status "CLOSED" requires "same-semantic-key-artifact-proof-witness"
  metrics vector "tests_executed,tests_reused,wall_ms,peak_rss_kib" pair "same-scenario-source-contract-toolchain-runner" improvement "exact-pair-only" forbidden "score,percentage,average,estimate"
  authority_rule repository_writes "0" output_scope "CALLER_OWNED_TEMP_OUTPUT_ONLY" automatic_commit "0" automatic_push "0" automatic_merge "0" automatic_release "0"
  generation "go" package "main" entrypoint "main"
  scenario "exact-proof-hit" expected "CLOSED" source "fixtures/sources/exact.gooo" cache_source "fixtures/sources/exact.gooo" variant "exact" replay "false"
  scenario "comment-only-semantic-hit" expected "CLOSED" source "fixtures/sources/commented.gooo" cache_source "fixtures/sources/base.gooo" variant "comment-only" replay "false"
  scenario "transitive-dependency-change" expected "REFUTED" source "fixtures/sources/exact.gooo" cache_source "fixtures/sources/exact.gooo" variant "dependency-change" replay "false"
  scenario "stale-terminal-witness" expected "REFUTED" source "fixtures/sources/exact.gooo" cache_source "fixtures/sources/exact.gooo" variant "stale-witness" replay "false"
  scenario "missing-proof" expected "UNKNOWN" source "fixtures/sources/exact.gooo" cache_source "fixtures/sources/exact.gooo" variant "missing-proof" replay "false"
  scenario "cross-toolchain" expected "UNKNOWN" source "fixtures/sources/exact.gooo" cache_source "fixtures/sources/exact.gooo" variant "cross-toolchain" replay "false"
  scenario "replay" expected "CLOSED" source "fixtures/sources/exact.gooo" cache_source "fixtures/sources/exact.gooo" variant "replay" replay "true"
}
